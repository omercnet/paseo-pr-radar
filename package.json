{
  "name": "@omercnet/paseo-pr-radar",
  "version": "0.3.1",
  "type": "module",
  "description": "A viewer-aware delivery queue for pull requests linked to Paseo workspaces.",
  "license": "MIT",
  "author": "Omer Cohen",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "pull-requests",
    "coding-agents"
  ],
  "files": [
    "bun.lock",
    "index.ts",
    "docs",
    "src",
    "paseo-plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "package:release": "bun scripts/package-release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@getpaseo/cli": "^0.7.2",
    "@getpaseo/client": "^0.7.2",
    "@getpaseo/plugin": "^0.7.2",
    "@getpaseo/protocol": "^0.7.2",
    "@tanstack/react-query": "^5.102.3",
    "@types/bun": "^1.4.0",
    "@types/react": "~19.2.0",
    "fflate": "^0.8.3",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
